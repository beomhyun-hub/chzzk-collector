# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤, 실제 값을 채워 넣으세요.
#   복사 명령: copy .env.example .env
# .env 파일은 .gitignore 에 등록되어 있어 GitHub 에 올라가지 않습니다.

# --- 치지직 개발자센터에서 발급받은 앱 키 ---
# https://developers.chzzk.naver.com > 애플리케이션 > 상세
CHZZK_CLIENT_ID=여기에_Client_ID_붙여넣기
CHZZK_CLIENT_SECRET=여기에_Client_Secret_붙여넣기

# --- 수집 범위 설정 (선택, 비워두면 아래 기본값 사용) ---
# 동접자 수가 이 값 미만이면 페이지 수집을 중단합니다.
MIN_CONCURRENT_USERS=5
# 안전장치: 한 번의 수집에서 요청할 최대 페이지 수
MAX_PAGES=200

# --- Supabase (3단계에서 채웁니다. 지금은 비워두세요) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
